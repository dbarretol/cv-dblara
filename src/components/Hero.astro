---
import { Image } from 'astro:assets';
import photo from '../assets/perfil.jpg';
import { cv } from '../lib/cv';
import { site } from '../data/site';

const name = cv.profile.name.replace(/^Dr\.\s*/, '');
const pdf = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${site.pdfFileName}`;
---

<header class="hero">
	<div class="hero-inner">
		<Image
			class="hero-photo"
			src={photo}
			alt="Retrato de David Barreto Lara"
			width={300}
			height={375}
			loading="eager"
			fetchpriority="high"
		/>
		<div>
			<h1><small>{site.honorific}</small>{name}</h1>
			<p class="headline">{site.headline}</p>
			<p class="focus">{site.focus}</p>
			<ul class="contact">
				<li><a href={`mailto:${cv.profile.email}`}>{cv.profile.email}</a></li>
				<li>{cv.profile.location}</li>
				<li><a href={cv.profile.linkedin}>LinkedIn</a></li>
				<li><a href={cv.profile.github}>GitHub</a></li>
			</ul>
			<div class="actions">
				<a class="btn btn-primary" href={pdf} download>Descargar CV (PDF)</a>
				<a class="btn" href={site.landing.url}>{site.landing.label}</a>
			</div>
		</div>
	</div>
</header>
